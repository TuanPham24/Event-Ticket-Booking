DATABASE_URL="postgresql://ticketing:ticketing@localhost:5432/ticketing?schema=public"
# Used only by `prisma migrate`; on providers with a pooled connection (e.g.
# Neon's pgbouncer "-pooler" host) this must be the non-pooled direct URL.
# Locally it's the same as DATABASE_URL.
DIRECT_URL="postgresql://ticketing:ticketing@localhost:5432/ticketing?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="change-me-in-production"
# Short-lived access token; the frontend transparently refreshes it via
# POST /auth/refresh using the longer-lived refresh token below.
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=3000
BOOKING_HOLD_MINUTES=10
# Frontend origin allowed to send/receive the httpOnly session cookie (CORS).
CORS_ORIGIN="http://localhost:5173"
